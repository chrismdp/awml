---
config:
  theme: default
  fontFamily: Inter, sans-serif
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph carers["carers#58; #43; June#44; Beth"]
    direction TB
    calendar{{"Nadia#39;s calendar"}}
    copy("<small style='color:rgb(61,67,79)'>⚙️ 📥 bring-in</small><br>Copy the pickups calendar")
    pickups[("Pickups")]
    screen@{ shape: win-pane, label: "Kitchen screen" }
    screen_gap@{ shape: notch-rect, label: "Missing from the design#58; no scheduled task keeps the screen current" }
    subgraph family["family#58; parents#44; kids"]
      direction TB
      thu(["Thursday 19#58;00"])
      sat(["Saturday 09#58;00"])
      favourites[("Favourites#44; recipes and the shopping list")]
      plan("<small style='color:rgb(61,67,79)'>🤖</small><br>Plan next week#39;s dinners")
      mealplan[("Meal plan")]
      chat@{ shape: win-pane, label: "Family chat" }
      fill("<small style='color:rgb(61,67,79)'>⚙️ 🛠️ do</small><br>Fill the basket from the plan and the list")
      basket>"Fill the basket#58; Allow under £180"]
      approve("<small style='color:rgb(61,67,79)'>👤 ✅ review</small><br>Owen#39;s yes to the exact basket")
      checkout>"Check out#58; Ask"]
      shop{{"Owen#39;s supermarket account"}}
      subgraph household["household#58; parents"]
        direction TB
        daily(["Every day 07#58;00"])
        bank{{"Joint account#44; on Owen#39;s consent"}}
        match("<small style='color:rgb(61,67,79)'>⚙️ 🔍 check</small><br>Match the account against the bills expected")
        parents_chat@{ shape: win-pane, label: "Parents#39; chat" }
      end
    end
  end

  thu --> plan
  favourites -.-> plan
  plan -.-> mealplan
  mealplan -.->|"posted"| chat
  sat --> fill
  mealplan -.-> fill
  favourites -.-> fill
  fill --> basket
  basket -.-> shop
  basket --> approve
  approve -->|"#91;yes#93;"| checkout
  checkout -.-> shop
  calendar -.-> copy
  copy -.-> pickups
  pickups -.-> screen
  screen <==>|"standing rule#58; dinners to carers"| mealplan
  screen -.- screen_gap
  daily --> match
  bank -.-> match
  match -.-> parents_chat
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class thu,sat,daily trig
  class pickups,favourites,mealplan ctx
  class calendar,shop,bank con
  class screen,chat,parents_chat surf
  class basket,checkout out
  class plan ai
  class copy,fill,match code
  class approve person
  class screen_gap gap
  style carers fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style family fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style household fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  linkStyle 15 stroke-dasharray:3,marker-end:none
  linkStyle 16 stroke:#8a93a3
