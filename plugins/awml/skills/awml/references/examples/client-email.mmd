---
flowchart TB
  subgraph private["private#58; the consultant"]
    direction TB
    mailbox{{"The consultant#39;s mailbox"}}
    weekdays(["Weekdays 07#58;00"])
    bring("<small style='color:rgb(61,67,79)'>⚙️ 📥 bring-in</small><br>Bring in the inbox")
    rules("<small style='color:rgb(61,67,79)'>⚙️ 🗂️ sort</small><br>Sort by rule#58; is the sender a client#63;")
    edit("<small style='color:rgb(61,67,79)'>👤 🛠️ do</small><br>Edit the reply and send it")
    send>"Send the reply#58; Ask"]
  end
  subgraph business["business#58; the consultant#44; an associate"]
    direction TB
    engagements[("The business#39;s engagements")]
    choose("<small style='color:rgb(61,67,79)'>🤖 🗂️ sort</small><br>Choose the engagement the email belongs to")
    learn("<small style='color:rgb(61,67,79)'>🤖 🧠 learn</small><br>Update the engagement#39;s project with what the email says")
    project[("The engagement#39;s project")]
    draft("<small style='color:rgb(61,67,79)'>🤖 ✏️ draft</small><br>Draft a reply")
    save("<small style='color:rgb(61,67,79)'>⚙️ 🛠️ do</small><br>Save the reply in the mailbox")
    saved>"Leave the reply in the drafts folder#58; Allow"]
  end

  weekdays --> bring
  mailbox -.-> bring
  bring --> rules
  rules --> choose
  rules ==>|"standing rule#58; a client#39;s email · adds an associate"| choose
  engagements -.-> choose
  choose --> learn
  learn -.-> project
  learn --> draft
  project -.-> draft
  draft --> save
  save --> saved
  save --> edit
  saved ==>|"the consultant takes the reply · loosens anthropic only to any company"| edit
  edit --> send
  mailbox <-.-> send
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
