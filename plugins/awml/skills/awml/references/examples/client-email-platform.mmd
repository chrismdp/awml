---
config:
  theme: default
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph cowork["Claude Cowork#44; Mac mini"]
    direction TB
    weekdays(["A scheduled task#44; weekdays 07#58;00"])
    bring("<small style='color:rgb(61,67,79)'>⚙️ 📥 bring-in</small><br>Bring in the inbox")
    rules("<small style='color:rgb(61,67,79)'>⚙️ 🗂️ sort</small><br>Sort by rule#58; is the sender a client#63;")
    choose("<small style='color:rgb(61,67,79)'>🤖 🗂️ sort</small><br>Choose the engagement the email belongs to")
    learn("<small style='color:rgb(61,67,79)'>🤖 🧠 learn</small><br>Update the engagement#39;s project with what the email says")
    draft("<small style='color:rgb(61,67,79)'>🤖 ✏️ draft</small><br>Draft a reply")
  end
  subgraph files["Synced Markdown notes"]
    direction TB
    engagements[("The business#39;s engagements")]
    project[("The engagement#39;s project")]
  end
  subgraph phone["The consultant#39;s phone"]
    direction TB
    edit("<small style='color:rgb(61,67,79)'>👤 🛠️ do</small><br>Edit the reply and send it")
  end
  subgraph gmail["Gmail"]
    direction TB
    mailbox{{"The consultant#39;s mailbox"}}
    drafts[("Drafts")]
    send>"Send the reply#58; Ask"]
  end

  weekdays -.-> bring
  mailbox --> bring
  bring --> rules
  rules ==>|"standing rule#58; a client#39;s email"| choose
  engagements --> choose
  choose --> learn
  learn --> project
  project --> draft
  draft --> drafts
  drafts ==>|"the consultant takes the reply"| edit
  edit --> send
  mailbox <--> send
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class weekdays trig
  class engagements,project,drafts ctx
  class mailbox con
  class send out
  class choose,learn,draft ai
  class bring,rules code
  class edit person
  style cowork fill:#e3ebfa,stroke:#b9c8e8,color:#16171b
  style files fill:#fbe9df,stroke:#ecc7b2,color:#16171b
  style phone fill:#efe6fa,stroke:#d3c2ea,color:#16171b
  style gmail fill:#fbf3d9,stroke:#e8d9a6,color:#16171b
  linkStyle 11 marker-end:none
