---
config:
  theme: default
  fontFamily: Inter, sans-serif
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph carers["carers#58; #43; June#44; Beth"]
    direction TB
    subgraph family["family#58; parents#44; kids"]
      direction TB
      subgraph household["household#58; parents"]
        direction TB
        daily(["Every day 07#58;00"])
        bank{{"Joint account#44; on Owen#39;s consent"}}
        match("<small style='color:rgb(61,67,79)'>⚙️ 🔍 check</small><br>Match the account against the bills expected")
        parents_chat@{ shape: win-pane, label: "Parents#39; chat" }
      end
    end
  end

  daily --> match
  bank -.-> match
  match -.-> parents_chat
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class daily trig
  class bank con
  class parents_chat surf
  class match code
  style carers fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style family fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style household fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
