---
config:
  theme: default
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph server["A server running scheduled jobs"]
    direction TB
    weekdays(["Weekdays 07:00"])
    bring("<small style='color:#3d434f'>📥 bring-in</small><br>Bring in the consulting inbox")
    rules("<small style='color:#3d434f'>🗂️ sort</small><br>Sort by rule: newsletters, receipts, sent mail")
    ask("<small style='color:#3d434f'>🛠️ do</small><br>Ask the consultant to approve the reply, saying what it is for")
  end
  subgraph model["A model, through its API"]
    direction TB
    choose("<small style='color:#3d434f'>🗂️ sort</small><br>Choose the engagement the email belongs to")
    learn("<small style='color:#3d434f'>🧠 learn</small><br>Update the engagement's project with what the email says")
    draft("<small style='color:#3d434f'>✏️ draft</small><br>Draft a reply")
  end
  subgraph files["Markdown notes, synced to each machine"]
    direction TB
    project[("The engagement's project")]
    drafts[("Drafts")]
  end
  subgraph phone["The consultant's phone"]
    direction TB
    today@{ shape: win-pane, label: "Today" }
    approve{"The consultant's yes to the exact reply"}
  end
  subgraph mailservice["The mail service"]
    direction TB
    mailbox{{"The consultant's mailbox"}}
    send>"Send the reply: Ask"]
  end

  weekdays -.-> bring
  mailbox --> bring
  bring --> rules
  rules -->|"no rule matches"| choose
  choose --> learn
  learn --> project
  project --> draft
  draft --> drafts
  drafts --> ask
  ask --> today
  today --> approve
  approve -->|"[yes]"| send
  send --> mailbox
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef rule fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef human fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class weekdays trig
  class project,drafts ctx
  class mailbox con
  class today surf
  class send out
  class choose,learn,draft ai
  class bring,rules,ask rule
  class approve human
  style server fill:#e3ebfa,stroke:#b9c8e8,color:#16171b
  style model fill:#fbe9df,stroke:#ecc7b2,color:#16171b
  style files fill:#efe6fa,stroke:#d3c2ea,color:#16171b
  style phone fill:#fbf3d9,stroke:#e8d9a6,color:#16171b
  style mailservice fill:#dff3ef,stroke:#b4ddd4,color:#16171b
