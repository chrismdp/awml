---
config:
  theme: default
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph server["A server running scheduled jobs"]
    direction TB
    weekdays(["Weekdays 07:00"])
    bring("Bring in the consulting inbox")
    rules("Sort by rule: newsletters, receipts, sent mail")
    daily(["Every day 06:15"])
    advance("Move the projects on, and ask for the send of each due draft")
  end
  subgraph model["A model, through its API"]
    direction TB
    sort("Choose where the email belongs from the projects listed, or nowhere with a reason")
  end
  subgraph files["Markdown notes, synced to each machine"]
    direction TB
    notes[("Business notes, with the engagement's project")]
    drafts[("Drafts")]
    draft_gap@{ shape: notch-rect, label: "Missing from the design: nothing drafts a reply to a client" }
  end
  subgraph mailservice["The mail service"]
    direction TB
    mail{{"The consultant's mailbox"}}
    send>"Send the mail: Ask"]
  end
  subgraph phone["The consultant's phone"]
    direction TB
    today@{ shape: win-pane, label: "Today" }
    approve{"Yes to the exact draft"}
  end

  weekdays -.-> bring
  mail --> bring
  bring --> rules
  rules -->|"no rule matches"| sort
  sort -->|"matched to its project"| notes
  notes ~~~ draft_gap
  draft_gap -.- drafts
  daily -.-> advance
  drafts --> advance
  advance --> today
  today --> approve
  approve -->|"[yes]"| send
  send --> mail
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef rule fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef human fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class weekdays,daily trig
  class notes,drafts ctx
  class mail con
  class today surf
  class send out
  class sort ai
  class bring,rules,advance rule
  class approve human
  class draft_gap gap
  style server fill:#e3ebfa,stroke:#b9c8e8,color:#16171b
  style model fill:#fbe9df,stroke:#ecc7b2,color:#16171b
  style files fill:#efe6fa,stroke:#d3c2ea,color:#16171b
  style mailservice fill:#fbf3d9,stroke:#e8d9a6,color:#16171b
  style phone fill:#dff3ef,stroke:#b4ddd4,color:#16171b
