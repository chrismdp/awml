---
config:
  theme: default
  fontFamily: Inter, sans-serif
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph carers["carers#58; #43; June#44; Beth"]
    direction TB
    carers_notes[("Carers notes")]
    subgraph family["family#58; parents#44; kids"]
      direction TB
      ask(["Someone in the family chat asks what time swimming is"])
      family_notes[("Family notes")]
      find("<small style='color:rgb(61,67,79)'>⚙️ 💬 answer</small><br>Find the notes that speak to it")
      word("<small style='color:rgb(61,67,79)'>🤖 💬 answer</small><br>Word the answer from those notes alone")
      chat@{ shape: win-pane, label: "Family chat" }
      subgraph nadia["nadia#58; Nadia"]
        direction TB
        nadia_notes[("Nadia#39;s own notes")]
      end
    end
  end

  ask --> find
  family_notes -.-> find
  carers_notes -.-> find
  find x-.-x|"never read here"| nadia_notes
  find --> word
  word -.->|"the answer#44; naming its notes"| chat
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class ask trig
  class carers_notes,family_notes,nadia_notes ctx
  class chat surf
  class word ai
  class find code
  style carers fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style family fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style nadia fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  linkStyle 3 marker-end:none
