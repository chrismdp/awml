---
config:
  theme: default
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph business["business: the consultant"]
    direction TB
    weekdays(["Weekdays 07:00"])
    mail{{"The business mail service, as the consultant"}}
    bring("<small style='color:#3d434f'>«bring-in»</small><br>Bring in the consulting inbox")
    rules("<small style='color:#3d434f'>«sort»</small><br>Sort by rule: newsletters, receipts, sent mail")
    sort("<small style='color:#3d434f'>«sort»</small><br>Choose where the email belongs from the projects listed, or nowhere with a reason")
    notes[("Business notes, with the engagement's project")]
    draft_gap@{ shape: notch-rect, label: "Missing from the design: no scheduled task or skill drafts a reply to a client" }
    daily(["Every day 06:15"])
    drafts[("Drafts")]
    advance("<small style='color:#3d434f'>«do»</small><br>Move the projects on, and ask for the send of each due draft")
    today@{ shape: win-pane, label: "Today, on the phone" }
    approve{"The approver of sends: yes to the exact draft"}
    send>"Send the mail: Ask"]
  end

  weekdays -.-> bring
  mail --> bring
  bring --> rules
  rules -->|"no rule matches"| sort
  sort -->|"matched to its project"| notes
  notes ~~~ draft_gap
  draft_gap -.- drafts
  daily -.-> advance
  drafts --> advance
  advance -->|"the draft to approve, with what it's for"| today
  today --> approve
  approve -->|"[yes]"| send
  send --> mail
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef rule fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef human fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class weekdays,daily trig
  class notes,drafts ctx
  class mail con
  class today surf
  class send out
  class sort ai
  class bring,rules,advance rule
  class approve human
  class draft_gap gap
  style business fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
