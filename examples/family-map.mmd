---
config:
  theme: default
  fontFamily: Inter, sans-serif
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  w1_thu(["Thursday 19#58;00"])
  w2_sat(["Saturday 09#58;00"])
  w3_daily(["Every day 07#58;00"])
  w4_changed(["A pickup changes in Nadia#39;s calendar"])
  w5_ask(["Someone in the family chat asks what time swimming is"])
  s1@{ shape: win-pane, label: "Kitchen screen" }
  s2[("Favourites#44; recipes and the shopping list")]
  s3[("Meal plan")]
  s4@{ shape: win-pane, label: "Family chat" }
  subgraph w1["The family#39;s dinners"]
    direction TB
  end
  subgraph w2["The family#39;s shopping"]
    direction TB
  end
  subgraph w3["The family#39;s bills check"]
    direction TB
  end
  subgraph w4["The family#39;s pickups"]
    direction TB
  end
  subgraph w5["A question in the family chat"]
    direction TB
  end

  w1_thu --> w1
  w2_sat --> w2
  w3_daily --> w3
  w4_changed --> w4
  w5_ask --> w5
  w1 -.-> s1
  w4 -.-> s1
  s2 -.-> w1
  s2 -.-> w2
  w1 <-.-> s3
  s3 -.-> w2
  w1 -.-> s4
  w5 -.-> s4
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class w1_thu,w2_sat,w3_daily,w4_changed,w5_ask trig
  class s2,s3 ctx
  class s1,s4 surf
  style w1 fill:#f6f7f9,stroke:#5d6472,color:#16171b
  style w2 fill:#f6f7f9,stroke:#5d6472,color:#16171b
  style w3 fill:#f6f7f9,stroke:#5d6472,color:#16171b
  style w4 fill:#f6f7f9,stroke:#5d6472,color:#16171b
  style w5 fill:#f6f7f9,stroke:#5d6472,color:#16171b
