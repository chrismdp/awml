---
config:
  theme: default
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph wider["with grandma#58; #43; Grandma Rose"]
    direction TB
    tablet@{ shape: win-pane, label: "Grandma Rose#39;s tablet" }
    subgraph parents["parents#58; Mia#44; Dev"]
      direction TB
      sun(["Sunday 18#58;00"])
      calendar{{"The parents#39; calendar"}}
      copy("<small style='color:rgb(61,67,79)'>⚙️ 📥 bring-in</small><br>Copy the week#39;s school pickups")
      pickups[("This week#39;s pickups")]
    end
  end

  sun -.-> copy
  calendar --> copy
  copy --> pickups
  pickups ==>|"standing rule#58; pickups to Grandma"| tablet
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class sun trig
  class pickups ctx
  class calendar con
  class tablet surf
  class copy code
  style wider fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style parents fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
