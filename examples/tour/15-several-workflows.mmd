---
flowchart TB
  subgraph bakery["bakery#58; Ana#44; Sam"]
    direction TB
    evening(["Every day 18#58;00"])
    morning(["Every day 07#58;00"])
    till{{"The till#39;s sales"}}
    count("<small style='color:rgb(61,67,79)'>⚙️ 📥 bring-in</small><br>Work out what the day#39;s baking used")
    stock[("Stock levels")]
    draft("<small style='color:rgb(61,67,79)'>🤖 ✏️ draft</small><br>Draft the order")
    ask("<small style='color:rgb(61,67,79)'>⚙️ 🛠️ do</small><br>Ask Ana to place it")
    approve("<small style='color:rgb(61,67,79)'>👤 ✅ review</small><br>Ana#39;s yes to the exact order")
    place>"Place the order#58; Ask"]
    supplier{{"The bakery#39;s supplier account"}}
