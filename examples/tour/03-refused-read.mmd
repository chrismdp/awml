---
config:
  theme: default
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph flat["flat: Tom, Ana, Joe"]
    direction TB
    ask(["Ana asks in the flat's chat when the boiler is serviced"])
    flat_notes[("Flat notes")]
    answer("<small style='color:#3d434f'>🤖 💬 answer</small><br>Answer from the flat's notes alone")
    chat@{ shape: win-pane, label: "The flat's chat" }
    subgraph tom["tom: Tom"]
      direction TB
      tom_notes[("Tom's own notes")]
    end
  end

  ask -.-> answer
  flat_notes --> answer
  tom_notes --x|"never read here"| answer
  answer -->|"the answer, naming its notes"| chat
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef rule fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef human fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class ask trig
  class flat_notes,tom_notes ctx
  class chat surf
  class answer ai
  style flat fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style tom fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
