---
config:
  theme: default
  fontFamily: Inter, sans-serif
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph flat["flat#58; Tom#44; Ana#44; Joe"]
    direction TB
    ask("Ana asks in the flat#39;s chat when the boiler is serviced")
    flat_notes[("Flat notes")]
    answer("<small style='color:rgb(61,67,79)'>🤖 💬 answer</small><br>Answer from the flat#39;s notes alone")
    chat@{ shape: win-pane, label: "The flat#39;s chat" }
    subgraph tom["tom#58; Tom"]
      direction TB
      tom_notes[("Tom#39;s own notes")]
    end
  end

  ask --> answer
  flat_notes -.-> answer
  tom_notes -.-x|"never read here"| answer
  answer -.->|"the answer#44; naming its notes"| chat
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class ask trig
  class flat_notes,tom_notes ctx
  class chat surf
  class answer ai
  style flat fill:transparent,stroke:#127c8c,stroke-width:1.5px,stroke-dasharray:6 4,color:#0d5c68
  style tom fill:transparent,stroke:#8c2f6b,stroke-width:1.5px,stroke-dasharray:6 4,color:#6b2251
