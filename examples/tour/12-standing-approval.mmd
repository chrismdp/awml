---
config:
  theme: default
  fontFamily: Inter, sans-serif
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph sam["sam#58; Sam"]
    direction TB
    morning(["Every morning 08#58;00"])
    library{{"Sam#39;s library account"}}
    renew("<small style='color:rgb(61,67,79)'>⚙️ 🛠️ do</small><br>Renew each book due back this week")
    action>"Renew the book#58; Ask#44; under Sam#39;s standing approval"]
    report("<small style='color:rgb(61,67,79)'>⚙️ 🛠️ do</small><br>List the renewal and how to undo it")
    list@{ shape: win-pane, label: "Sam#39;s list" }
    terms@{ shape: notch-rect, label: "Standing approval from Sam#58; renewals only#44; up to six a week" }
  end

  morning -.-> renew
  library -->|"books due back"| renew
  renew --> action
  library <--> action
  action --> report
  report --> list
  action -.- terms
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class morning trig
  class library con
  class list surf
  class action out
  class renew,report code
  class terms gap
  style sam fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  linkStyle 3 marker-end:none
