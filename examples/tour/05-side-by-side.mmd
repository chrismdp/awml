---
config:
  theme: default
  fontFamily: Inter, sans-serif
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph bakery["bakery#58; Jo#44; Ben#44; Lou"]
    direction TB
    monday(["Monday 09#58;00"])
    invoices[("The bakery#39;s invoices")]
    checklist[("Jo#39;s checklist for chasing")]
    chase("<small style='color:rgb(61,67,79)'>🤖 ✏️ draft</small><br>Draft a reminder for each late invoice")
  end
  subgraph pottery["pottery#58; Jo#44; Kit"]
    direction TB
    shop_notes[("The shop#39;s notes")]
    remind("<small style='color:rgb(61,67,79)'>🤖 ✏️ draft</small><br>Draft a reminder for each late order")
  end

  monday --> chase
  chase --> remind
  invoices -.-> chase
  checklist -.-> chase
  checklist ==>|"the checklist#44; with no names in it · adds Kit"| shop_notes
  shop_notes -.-> remind
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class monday trig
  class invoices,checklist,shop_notes ctx
  class chase,remind ai
  style bakery fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  style pottery fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
  linkStyle 4 stroke-dasharray:3
