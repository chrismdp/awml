---
config:
  theme: default
  flowchart:
    useMaxWidth: false
    subGraphTitleMargin:
      top: 6
      bottom: 30
---
flowchart TB
  subgraph house["house: Sam, Priya"]
    direction TB
    monday(["Monday 06:00"])
    council{{"The council's bin calendar"}}
    copy("<small style='color:#3d434f'>⚙️ 📥 bring-in</small><br>Copy this week's bin day")
    bins[("Bin days")]
    chat@{ shape: win-pane, label: "The house chat" }
    gap@{ shape: notch-rect, label: "Missing from the design: nothing posts the bin day here the night before" }
  end

  monday -.-> copy
  council --> copy
  copy --> bins
  bins ~~~ chat
  gap -.- chat
  classDef trig fill:#fbe1ee,stroke:#a33a74,color:#16171b
  classDef ctx fill:#e2eef9,stroke:#3d6fa3,color:#16171b
  classDef con fill:#eceef2,stroke:#5d6472,color:#16171b
  classDef surf fill:#ffffff,stroke:#2a2d35,stroke-width:1.5px,color:#16171b
  classDef out fill:#fde4dc,stroke:#b5532f,color:#16171b
  classDef ai fill:#cdd3fb,stroke:#3b4bb0,color:#16171b
  classDef code fill:#c4e3d1,stroke:#2b7a4f,color:#16171b
  classDef person fill:#f7d79a,stroke:#9a6100,color:#16171b
  classDef uml fill:#16171b,stroke:#16171b,color:#16171b
  classDef gap fill:#ffffff,stroke:#8a93a3,stroke-dasharray:4 3,color:#6b7280
  class monday trig
  class bins ctx
  class council con
  class chat surf
  class copy code
  class gap gap
  style house fill:transparent,stroke:#8a93a3,stroke-dasharray:6 4,color:#3d434f
